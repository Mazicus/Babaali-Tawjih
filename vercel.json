{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "hnd1"
  ],
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/(?:app|bootstrap|config|database|legacy|resources|routes|storage|tests|vendor|public|api)(?:/.*)?",
      "status": 404
    },
    {
      "src": "/(?:\\..*|.*\\.(?:sql|md|original)|composer\\.(?:json|lock)|artisan)",
      "status": 404
    },
    {
      "src": "/(img|svg|data)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/([A-Za-z-]+\\.(?:css|js))",
      "dest": "/public/$1"
    },
    {
      "src": "/.*",
      "dest": "/api/index.php"
    }
  ]
}